<%- include('../partials/header', { title: 'Статистика' }) %>

  <div class="container">
    <h1>Статистика продаж</h1>
    
    <div class="summary-cards">
      <div class="card">
        <h3>Общий доход</h3>
        <p>
          <% if (totalStats && totalStats.total_revenue) { %>
            <%= Number(totalStats.total_revenue).toLocaleString('ru-RU') %> ₽
          <% } else { %>
            0 ₽
          <% } %>
        </p>
      </div>
      <div class="card">
        <h3>Всего заказов</h3>
        <p><%= totalStats.total_orders %></p>
      </div>
      <div class="card">
        <h3>Средний чек</h3>
        <p>
            <% if (totalStats.avg_order_value) { %>
              <%= Number(totalStats.avg_order_value).toFixed(2).toLocaleString('ru-RU') %> ₽
            <% } else { %>
              0.00 ₽
            <% } %>
          </p>
      </div>
<!-- Карточка уникальных посетителей -->
<div class="card">
  <h3>Посетители</h3>
  <p>
    <% if (visitorStats && visitorStats.unique_visitors) { %>
      <%= Number(visitorStats.unique_visitors).toLocaleString('ru-RU') %>
    <% } else { %>
      0
    <% } %>
  </p>
  <small>Уникальные за 30 дней</small>
</div>

<!-- Карточка общего числа посещений -->
<div class="card">
  <h3>Просмотры</h3>
  <p>
    <% if (visitorStats && visitorStats.total_visits) { %>
      <%= Number(visitorStats.total_visits).toLocaleString('ru-RU') %>
    <% } else { %>
      0
    <% } %>
  </p>
  <small>Всего посещений</small>
</div>

<div class="chart-container">
  <h2>Продажи по месяцам</h2>
  <div class="chart-wrapper">
    <canvas id="monthlyChart"></canvas>
  </div>
</div>

<div class="chart-container">
  <h2>Посещаемость по месяцам</h2>
  <div class="chart-wrapper">
    <canvas id="visitorsChart"></canvas>
  </div>
</div>

    <div class="tables-container">
      <div class="top-products">
        <h2>Топ товаров</h2>
        <table>
          <thead>
            <tr>
              <th>Товар</th>
              <th>Продано</th>
              <th>Доход</th>
            </tr>
          </thead>
          <tbody>
            <% topProducts.forEach(product => { %>
              <tr>
                <td><%= product.product_name %></td>
                <td><%= product.total_sold %></td>
                <td><%= product.total_revenue.toLocaleString('ru-RU') %> ₽</td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="recent-orders">
        <h2>Последние заказы</h2>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Покупатель</th>
              <th>Дата</th>
              <th>Товаров</th>
              <th>Сумма</th>
            </tr>
          </thead>
          <tbody>
            <% recentOrders.forEach(order => { %>
              <tr>
                <td><%= order.id %></td>
                <td><%= order.username %></td>
                <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                <td><%= order.items_count %></td>
                <td><%= order.total.toLocaleString('ru-RU') %> ₽</td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // График продаж по месяцам
      const monthlyCtx = document.getElementById('monthlyChart').getContext('2d');
      const monthlyData = <%- JSON.stringify(monthlyStats || []) %>;
      
      if (monthlyData && monthlyData.length > 0) {
        new Chart(monthlyCtx, {
          type: 'bar',
          data: {
            labels: monthlyData.map(s => s.month),
            datasets: [{
              label: 'Доход (₽)',
              data: monthlyData.map(s => parseFloat(s.revenue || 0)),
              backgroundColor: 'rgba(54, 162, 235, 0.7)',
              borderColor: 'rgba(54, 162, 235, 1)',
              borderWidth: 1
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: function(value) {
                    return value.toLocaleString('ru-RU') + ' ₽';
                  }
                }
              }
            }
          }
        });
      } else {
        document.getElementById('monthlyChart').innerHTML = '<p class="no-data">Нет данных о продажах</p>';
      }
    
      const statsData = <%- JSON.stringify(monthlyStat || []) %>;
  
  // График посещаемости
  if (statsData.length > 0) {
    const visitorsCtx = document.getElementById('visitorsChart').getContext('2d');
    new Chart(visitorsCtx, {
      type: 'line',
      data: {
        labels: statsData.map(item => item.month),
        datasets: [{
          label: 'Уникальные посетители',
          data: statsData.map(item => item.visitors),
          borderColor: 'rgb(75, 192, 192)',
          backgroundColor: 'rgba(75, 192, 192, 0.2)',
          borderWidth: 2,
          tension: 0.1
        }]
      },
      options: {
        responsive: true,
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              precision: 0
            }
          }
        }
      }
    });
  } else {
    document.getElementById('visitorsChart').innerHTML = '<p>Нет данных о посещаемости</p>';
  }

    });
    </script>